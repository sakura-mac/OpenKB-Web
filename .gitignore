web/node_modules/
node_modules/
.npm/
.parcel-cache/

# Go
vendor/
*.test
*.out

# 用户数据 / 运行时
okb-spaces/
.openkb/
.cache/

# 环境变量 / 密钥
.env
.env.local
*.local

# IDE
.vscode/
.idea/
*.swp

# 系统
.DS_Store
Thumbs.db

